# OpenRouter API Key (Required)
# Get your API key at: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Server Port (Optional, default: 8080)
PORT=8080

# Allowed regions (comma-separated, first value is the default)
# "global" = most common wallpaper across all Bing markets
# Locale codes (e.g. "en-US", "ja-JP") = that market's wallpaper
# Default: global
# ALLOWED_REGIONS=global

# Allowed languages for AI translation (comma-separated, first value is the default)
# Controls which language values the /api/v2/colors?language= param accepts
# Leave empty to disable translation entirely
# Default: English
# ALLOWED_LANGUAGES=English

# Write AI responses to file for debugging
# DEBUG_AI_RESPONSES=true

# Cache Directory (default: ./cache_data)
# CACHE_DIR=./cache_data
